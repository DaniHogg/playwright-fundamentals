# Copy this file to .env and adjust values as needed for local runs.
# .env / .env.local are gitignored — never commit real secrets here.
#
# Both the JS suite (test-js/site-path.js, playwright.config.js) and the Python
# suite (test-py/conftest.py) read these two variables to build the URLs they
# test against. Leave them unset to test the live portfolio site.

# Origin of the site under test (no trailing slash).
BASE_URL=https://danihogg.github.io

# GitHub Pages subpath appended after BASE_URL (leading slash, no trailing slash).
# This must exactly match the live site's path - verify with:
#   curl -I https://danihogg.github.io/qa-portfolio-livesite/
SITE_BASE_PATH=/qa-portfolio-livesite
